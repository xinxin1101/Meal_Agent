# Copy this file to .env and fill in the values locally. Never commit .env.
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
MEALPILOT_ADMIN_USERNAME=root
# Required for the production Compose stack; development defaults to the documented bootstrap password.
MEALPILOT_ADMIN_PASSWORD=
MEALPILOT_ADMIN_DISPLAY_NAME=Root Administrator
# Test/fixture mode only. Runtime defaults to published and review datasets without sample recipes.
MEALPILOT_INCLUDE_SAMPLE_RECIPES=false
MEALPILOT_RECIPE_DATA_ROOT=.runtime/recipe-data
SILICONFLOW_MULTI_AGENT_ENABLED=false

# Production Compose only. Use long random values and never commit .env.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MEALPILOT_DOMAIN=
ACME_EMAIL=
MEALPILOT_RATE_LIMIT_PER_MINUTE=60
MEALPILOT_ALLOWED_HOSTS=localhost,127.0.0.1
MEALPILOT_AUTH_SECRET=
MEALPILOT_ENV=development
# Production HTTPS deployments set this true. Local HTTP development keeps it false.
MEALPILOT_SECURE_COOKIES=false
# Optional local/test-only override. Production uses PostgreSQL instead.
MEALPILOT_RUNTIME_DIR=.runtime
# Container images set this to /app. Local development normally leaves it unset.
MEALPILOT_PROJECT_ROOT=
