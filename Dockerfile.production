FROM python:3.11-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY backend ./backend
COPY data ./data
COPY config ./config
COPY migrations ./migrations
COPY scripts ./scripts
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir ".[production]"
RUN useradd --system --uid 10001 mealpilot && mkdir -p /app/recipe-data && chown -R mealpilot:mealpilot /app
USER mealpilot
EXPOSE 8000
CMD ["uvicorn", "mealpilot.main:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
